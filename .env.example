# Firebase web app config (Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: VAPID key for FCM web push (Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Set to "true" to force local demo persistence even if Firebase env is present
VITE_DEMO_MODE=false
